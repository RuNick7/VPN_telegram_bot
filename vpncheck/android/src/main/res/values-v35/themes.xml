<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps under the system bars; the page is laid out
         for a window between them, so keep that. -->
    <style name="Theme.Check" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
