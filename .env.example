# Telegram Bot Configuration (admin_bot)
Admin_bot_token=
ADMIN_IDS=
# Токен user_bot для рассылки
USER_BOT_TOKEN=
# Имя бота (без @) — используется для return_url после оплаты
TELEGRAM_BOT_USERNAME=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Remnawave API
REMNAWAVE_BASE_URL=
REMNAWAVE_USERNAME=
REMNAWAVE_PASSWORD=
REMNAWAVE_TOKEN=
# Optional alias for API token (used by admin_bot too)
REMNAWAVE_API_KEY=
REMNAWAVE_TIMEOUT_SECONDS=5

# Database Configuration (Postgres — replaces SQLite from Phase 1 onward)
POSTGRES_USER=tgvpn
POSTGRES_PASSWORD=tgvpn
POSTGRES_DB=tgvpn
# Host-side port for docker-compose's postgres service (container always listens on 5432)
POSTGRES_HOST_PORT=5433
# DSN used by admin_bot/user_bot to connect. Inside docker-compose, host is the
# `postgres` service name; when running a bot outside compose (e.g. local dev),
# use 127.0.0.1:${POSTGRES_HOST_PORT}.
DATABASE_URL=postgresql://tgvpn:tgvpn@postgres:5432/tgvpn

# Legacy SQLite path (pre-Phase-1, kept only for the one-off ETL script)
USER_BOT_DB_PATH=../user_bot/data/subscription.db
DB_PATH=./user_bot/data/subscription.db

# Backup Configuration (admin_bot)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
SUBSCRIPTION_DB_BACKUP_DIR=./backups/subscription_db
REMNAWAVE_BACKUP_ENABLED=true

# Logging Configuration (admin_bot)
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# Monitoring Configuration (admin_bot)
MONITOR_INTERVAL_MINUTES=5
NODE_RAM_MAX_PERCENT=90

# Subscription defaults (user_bot)
TRIAL_DAYS=30
TIMEZONE=Moscow
STATUS_CHANNEL_URL=https://t.me/vpn_channel
FAQ_URL=https://gitbook.io/
SHOW_VIDEO_INSTRUCTIONS=false

# Internal squads
INTERNAL_SQUAD_MAX_USERS=175
INTERNAL_SQUAD_PREFIX=internal

# --- FREE tier (Phase 3) ---
# OFF by default. Turning this on makes a background job the only thing that
# cuts off expired subscriptions -- panel accounts stop expiring by themselves.
# Read docs/phase3-free-lte-rollout.md before enabling.
FREE_TIER_ENABLED=false
FREE_SQUAD_NAME=FREE
FREE_TIER_PANEL_EXPIRE_YEARS=10

# --- LTE traffic quotas (Phase 3) ---
LTE_ENABLED=false
LTE_SQUAD_NAME=LTE
LTE_CYCLE_DAYS=30
LTE_FREE_GB_PER_CYCLE=10
# Which nodes count against the quota. UUIDs win when both are set.
LTE_NODE_UUIDS=
LTE_NODE_NAME_KEYWORDS=lte

# --- Service health monitoring (Phase 3) ---
SERVICE_MONITOR_ENABLED=true
WEBHOOK_HEALTH_URL=http://127.0.0.1:8000/health
USER_BOT_HEARTBEAT_PATH=/tmp/user_bot_heartbeat
SERVICE_MONITOR_STALE_MINUTES=10
# A job counts as dead at this multiple of its own interval.
JOB_STALE_INTERVAL_MULTIPLIER=2.0
