# Telegram Bot Configuration (admin_bot)
Admin_bot_token=
ADMIN_IDS=
# Токен user_bot для рассылки
USER_BOT_TOKEN=
# Имя бота (без @) — используется для return_url после оплаты
TELEGRAM_BOT_USERNAME=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Remnawave API
REMNAWAVE_BASE_URL=
REMNAWAVE_USERNAME=
REMNAWAVE_PASSWORD=
REMNAWAVE_TOKEN=
# Optional alias for API token (used by admin_bot too)
REMNAWAVE_API_KEY=
REMNAWAVE_TIMEOUT_SECONDS=5

# Database Configuration (Postgres — replaces SQLite from Phase 1 onward)
POSTGRES_USER=tgvpn
POSTGRES_PASSWORD=tgvpn
POSTGRES_DB=tgvpn
# Host-side port for docker-compose's postgres service (container always listens on 5432)
POSTGRES_HOST_PORT=5433
# DSN used by admin_bot/user_bot to connect. Inside docker-compose, host is the
# `postgres` service name; when running a bot outside compose (e.g. local dev),
# use 127.0.0.1:${POSTGRES_HOST_PORT}.
DATABASE_URL=postgresql://tgvpn:tgvpn@postgres:5432/tgvpn

# Legacy SQLite path (pre-Phase-1, kept only for the one-off ETL script)
USER_BOT_DB_PATH=../user_bot/data/subscription.db
DB_PATH=./user_bot/data/subscription.db

# Backup Configuration (admin_bot)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
SUBSCRIPTION_DB_BACKUP_DIR=./backups/subscription_db
REMNAWAVE_BACKUP_ENABLED=true

# Logging Configuration (admin_bot)
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# Monitoring Configuration (admin_bot)
MONITOR_INTERVAL_MINUTES=5
NODE_RAM_MAX_PERCENT=90

# The free period, in two halves.
#
# TRIAL_DAYS is what signing up is worth, on whichever side the person
# arrives -- the bot reads this now too, having carried its own hardcoded 30
# and handed out a different trial from the same deployment.
#
# TRIAL_LINK_BONUS_DAYS is what connecting the *second* identity is worth:
# Telegram attached to an account that arrived by email, or a confirmed
# address attached to one that arrived through the bot. Each is granted at
# most once per account, so the free period tops out at their sum.
TRIAL_DAYS=7
TRIAL_LINK_BONUS_DAYS=7
TIMEZONE=Moscow
STATUS_CHANNEL_URL=https://t.me/vpn_channel
FAQ_URL=https://gitbook.io/
SHOW_VIDEO_INSTRUCTIONS=false

# Internal squads
# The single squad every paying subscriber goes into. Must exist in the panel
# under exactly this name -- the bots never create squads. Users are no longer
# spread across internal-1..N; load is handled by balancers in front of the
# nodes instead.
PAID_SQUAD_NAME=internal

# --- FREE tier (Phase 3) ---
# OFF by default. Turning this on makes a background job the only thing that
# cuts off expired subscriptions -- panel accounts stop expiring by themselves.
# Read docs/phase3-free-lte-rollout.md before enabling.
FREE_TIER_ENABLED=false
FREE_SQUAD_NAME=FREE
FREE_TIER_PANEL_EXPIRE_YEARS=10

# --- LTE traffic quotas (Phase 3) ---
LTE_ENABLED=false
LTE_SQUAD_NAME=LTE
LTE_CYCLE_DAYS=30
LTE_FREE_GB_PER_CYCLE=10
# Which nodes count against the quota. UUIDs win when both are set.
LTE_NODE_UUIDS=
LTE_NODE_NAME_KEYWORDS=lte

# --- Service health monitoring (Phase 3) ---
SERVICE_MONITOR_ENABLED=true
WEBHOOK_HEALTH_URL=http://127.0.0.1:8000/health
USER_BOT_HEARTBEAT_PATH=/tmp/user_bot_heartbeat
SERVICE_MONITOR_STALE_MINUTES=10
# A job counts as dead at this multiple of its own interval.
JOB_STALE_INTERVAL_MULTIPLIER=2.0

# -- Website (Go backend, web/) ---------------------------------------------
# The server refuses to start without WEB_BASE_URL and SMTP_HOST/SMTP_FROM:
# a magic link is only as private as the channel it travels on, and the old
# backend's mock sender returned the token in the API response instead.
WEB_BASE_URL=https://cabinet.example.com
WEB_LISTEN_ADDR=:8080
WEB_HOST_PORT=8080
WEB_SESSION_TTL_HOURS=720
WEB_MAGIC_LINK_TTL_MINUTES=15
# Free days granted when someone signs up on the site and has no panel account
# yet. Falls back to TRIAL_DAYS; set to 0 to switch the trial off. Granted once
# per account -- a user who has lapsed and come back is not eligible again.
WEB_TRIAL_DAYS=7

# Read by the website *and* by the bot: the site sends sign-in links, the
# bot sends the letter that confirms an address. One mailbox, one place a
# wrong password shows up. The site refuses to start without HOST and FROM;
# the bot degrades instead and stops offering the email bonus.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# true for STARTTLS on 587, false for implicit TLS on 465.
SMTP_STARTTLS=true

# Legal documents, linked from /docs in the bot and from the website's footer
# and profile page.
#
# Two of them: the licence agreement (which is also the public offer and
# carries the refund terms) and the privacy policy.
#
# The site hosts them itself at /docs/<name>, and leaving these empty points
# the website at those pages. Set them to absolute URLs so the *bot* can link
# to the same documents -- it has no site-relative paths to resolve:
#   LICENSE_URL=https://kairavpn.pro/docs/license
LICENSE_URL=
PRIVACY_POLICY_URL=

# Where "написать в поддержку" points on the website. Empty hides the link.
SUPPORT_URL=
